{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "services": {
    "portal": {
      "runtime": "container",
      "root": "portal/",
      "entrypoint": "Dockerfile"
    },
    "pokerRealtime": {
      "root": "poker-realtime/",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "redirects": [
    { "source": "/royal-arc", "destination": "/royal-arc/index.html", "permanent": false },
    { "source": "/poker", "destination": "/poker/index.html", "permanent": false },
    { "source": "/roulette", "destination": "/roulette/index.html", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/api/games/poker/ws",
      "destination": {
        "service": "pokerRealtime"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "portal"
      }
    }
  ]
}
